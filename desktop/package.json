{
  "name": "filerecall-desktop",
  "private": true,
  "version": "0.4.7",
  "description": "FileRecall local file and download history",
  "author": "FileRecall contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env FILERECALL_DEV_SERVER=http://127.0.0.1:5173 node electron/launch.cjs\"",
    "build": "tsc --noEmit && vite build",
    "start": "node electron/launch.cjs",
    "test": "node --test electron/*.test.cjs",
    "package:win": "npm run build && powershell -NoProfile -File native/build-host.ps1 -OutputDirectory .package-host && electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "electron-updater": "6.8.11",
    "onnxruntime-node": "1.21.0",
    "saxes": "6.0.0",
    "unpdf": "2.2.1",
    "yauzl": "3.4.0",
    "pinyin-pro": "3.29.5"
  }
}
